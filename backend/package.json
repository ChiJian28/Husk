{
  "name": "husk-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Husk — event coverage for onchain bags. Thetanuts V4 underwriter API on Base.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run",
    "smoke:calendar": "tsx src/scripts/smoke-calendar.ts",
    "smoke:quote": "tsx src/scripts/smoke-quote.ts",
    "smoke:preview": "tsx src/scripts/smoke-preview.ts",
    "smoke:rfq": "tsx src/scripts/smoke-rfq-dryrun.ts",
    "smoke:fill": "tsx src/scripts/smoke-fill-tiny.ts",
    "claim:broker": "tsx src/scripts/claim-broker-fees.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@supabase/supabase-js": "^2.109.0",
    "@thetanuts-finance/thetanuts-client": "^0.3.0",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "hono": "^4.13.5",
    "langsmith": "^0.9.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
